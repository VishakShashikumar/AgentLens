# Copy this file to .env and fill in your key to run AgentLens against a real model.
# Without this, AgentLens runs entirely on AGENTLENS_LLM_PROVIDER=mock (the default),
# which is deterministic and requires no network access or API key.

# "mock" (default, no key needed) or "anthropic" (real Claude calls)
AGENTLENS_LLM_PROVIDER=mock

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5
